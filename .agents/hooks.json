{
  "android-security-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|read_file|write_file|edit_file|view_file|write_to_file|replace_file_content|multi_replace_file_content|grep_search|find_by_name|list_dir",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/security_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
